# Database Configuration
DATABASE_URL=postgresql://postgres:1234@db:5432/scholarpass_db
DATABASE_ECHO=False
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=scholarpass_db
DB_HOST=db
DB_PORT=5434

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application Configuration
PORT=8000
DEBUG=False
ENVIRONMENT=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database Auto Migration
DB_AUTO_MIGRATE=true
